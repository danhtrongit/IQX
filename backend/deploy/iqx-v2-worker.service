[Unit]
Description=IQX v2 market report worker
After=network-online.target postgresql.service iqx-v2-redis.service
Wants=network-online.target
Requires=iqx-v2-redis.service

[Service]
Type=simple
User=iqx-v2
Group=iqx-v2
WorkingDirectory=/srv/iqx-v2/current/backend
EnvironmentFile=/srv/iqx-v2/shared/runtime.env
ExecStart=/usr/bin/node dist/src/bootstrap/worker.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
# Normal peak is about 350 MB. A runaway job must kill this worker, not stall the whole box
# (API, nginx and Postgres share it): --max-old-space-size would not help, the 2026-11-05 OOM was
# native memory outside the V8 heap. systemd restarts it through Restart=on-failure.
MemoryHigh=1G
MemoryMax=1500M
MemorySwapMax=256M
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/iqx-v2/shared/media
StandardOutput=journal
StandardError=journal
SyslogIdentifier=iqx-v2-worker

[Install]
WantedBy=multi-user.target
