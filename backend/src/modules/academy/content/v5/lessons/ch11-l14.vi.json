  "format": "iqx-academy-lesson-v3",
  "id": "ch11-l14",
  "intro_blocks": [],
  "kind": "lesson",
  "lead": "Tài sản công ty chứng khoán chủ yếu là tiền, khoản cho vay margin và chứng khoán tự doanh, phần lớn ghi theo giá trị hợp lý. Vốn chủ sổ sách vì vậy khá sát giá trị thật, và P/B là thước đo định giá phổ biến cho ngành này.",
  "lesson_key": "fundamental:pb-ck",
  "order": 14,
  "sections": [
    {
      "blocks": [
        {
          "chart_id": "c11l14-g1",
          "type": "chart"
        },
        {
          "text": "P/B bằng <b>vốn hoá</b> chia <b>vốn chủ sở hữu</b> của quý gần nhất đã công bố. Cách tính giống bài P/B ở phần chỉ tiêu chung.",
          "type": "paragraph"
        }
      ],
      "id": "s1",
      "title": "Nhắc lại công thức"
    },
    {
      "blocks": [
        {
          "chart_id": "c11l14-g2",
          "type": "chart"
        },
        {
          "columns": 3,
          "items": [
            {
              "text": "Giá cổ phiếu chứng khoán thường tăng trước khi lợi nhuận tăng, vì thị trường kỳ vọng thanh khoản quay lại.",
              "title": "P/B đi trước lợi nhuận"
            },
            {
              "text": "FVTPL ghi theo giá thị trường. HTM và cho vay ghi theo giá gốc trừ dự phòng.",
              "title": "Tài sản ghi gần giá trị thật"
            },
            {
              "text": "P/B công ty chứng khoán dao động mạnh hơn ngân hàng.",
              "title": "Biến động mạnh"
            }
          ],
          "style": "tip",
          "type": "cards"
        }
      ],
      "id": "s2",
      "title": "Ở công ty chứng khoán khác gì"
    },
    {
      "blocks": [
        {
          "chart_id": "c11l14-rep",
          "title": "P/B",
          "type": "chart"
        },
        {
          "columns": 3,
          "items": [
            {
              "text": "P/B theo giá đóng cửa và vốn chủ quý đã công bố.",
              "title": "Đường theo ngày"
            },
            {
              "text": "Trung vị và dải cộng trừ một độ lệch chuẩn.",
              "title": "Đường nét đứt và dải"
            },
            {
              "text": "P/B gần cận dưới của dải thường trùng với thị trường trầm lắng.",
              "title": "Đọc cùng nhau"
            }
          ],
          "style": "tip",
          "type": "cards"
        }
      ],
      "id": "s3",
      "title": "Biểu đồ đại diện"
    },
    {
      "blocks": [
        {
          "columns": 2,
          "items": [
            {
              "text": "P/B gần cận dưới dải lịch sử. Mức tham khảo, thường gặp khi thanh khoản thị trường thấp.",
              "title": "Vùng thấp",
              "tone": "pos"
            },
            {
              "text": "P/B gần cận trên dải, thị trường đang kỳ vọng nhiều vào chu kỳ tốt.",
              "title": "Vùng cao",
              "tone": "neg"
            }
          ],
          "style": "card",
          "type": "cards"
        },
        {
          "text": "Đọc P/B cùng <b>ROE bình quân qua chu kỳ</b>, không chỉ ROE hiện tại.",
          "type": "paragraph"
        }
      ],
      "id": "s4",
      "title": "Đọc chỉ tiêu"
    },
    {
      "blocks": [
        {
          "columns": 3,
          "items": [
            {
              "text": "Dùng dải trên Dashboard.",
              "title": "So với lịch sử"
            },
            {
              "text": "ROE bình quân cao thì P/B cao hơn là hợp lý.",
              "title": "Đọc cùng ROE"
            },
            {
              "text": "Dự phòng cho vay margin thiếu làm vốn chủ sổ sách cao hơn thật.",
              "title": "Kiểm tra chất lượng tài sản"
            }
          ],
          "style": "tip",
          "type": "cards"
        }
      ],
      "id": "s5",
      "title": "Cách sử dụng"
    },
    {
      "blocks": [
        {
          "text": "Công ty chứng khoán mẫu, P/B 2 năm gần nhất.",
          "type": "paragraph"
        },
        {
          "items": [
            {
              "term": "P/B cuối Q2/26",
              "text": "1,26 lần."
            },
            {
              "term": "Trung vị 2 năm",
              "text": "1,37 lần."
            },
            {
              "term": "Thấp nhất và cao nhất",
              "text": "1,15 lần và 1,67 lần."
            },
            {
              "term": "Nhận xét",
              "text": "P/B dưới trung vị trong giai đoạn ROE giảm còn 3,6%."
            }
          ],
          "type": "definitions"
        }
      ],
      "id": "s6",
      "title": "Ví dụ cụ thể"
    },
    {
      "blocks": [
        {
          "columns": 3,
          "items": [
            {
              "text": "ROE đáy chu kỳ làm P/B trông đắt.",
              "title": "Dùng ROE hiện tại"
            },
            {
              "text": "Mô hình và biến động khác.",
              "title": "So với ngân hàng"
            },
            {
              "text": "Tự doanh FVTPL đã phản ánh giá thị trường vào vốn chủ.",
              "title": "Quên giá trị hợp lý"
            }
          ],
          "style": "tip",
          "type": "cards"
        }
      ],
      "id": "s7",
      "title": "Sai lầm thường gặp"
    }
  ],
  "summary": [
    "<b>P/B</b> = vốn hoá ÷ vốn chủ sở hữu.",
    "Tài sản ghi gần giá trị thật nên <b>P/B phù hợp</b>.",
    "P/B <b>dao động theo chu kỳ thị trường</b>.",
    "Đọc cùng <b>ROE bình quân qua chu kỳ</b>."
  ],
  "title": "P/B · ở công ty chứng khoán"
}
