      "id": "s6",
      "title": "Ví dụ cụ thể"
    },
    {
      "blocks": [
        {
          "columns": 3,
          "items": [
            {
              "text": "Thu nhập lãi gộp chưa trừ chi phí lãi, không phản ánh chênh lệch lãi.",
              "title": "Dùng thu nhập lãi gộp"
            },
            {
              "text": "Quý 4 luôn cao hơn.",
              "title": "So quý liền kề"
            },
            {
              "text": "Lãi chứng khoán khó lặp lại hơn lãi từ cho vay.",
              "title": "Coi mọi tăng trưởng như nhau"
            }
          ],
          "style": "tip",
          "type": "cards"
        }
      ],
      "id": "s7",
      "title": "Sai lầm thường gặp"
