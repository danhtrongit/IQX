          "items": [
            {
              "text": "ROIC năm giá dầu cao không đại diện cho cả chu kỳ.",
              "title": "Đọc ở đỉnh chu kỳ"
            },
            {
              "text": "Tiền mặt lớn làm vốn đầu tư phình ra, ROIC thấp giả.",
              "title": "Không trừ tiền"
            },
            {
              "text": "Khai thác và phân phối có cấu trúc vốn rất khác.",
              "title": "So khác mảng"
            }
          ],
          "style": "tip",
