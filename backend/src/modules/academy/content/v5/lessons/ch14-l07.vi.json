        }
      ],
      "id": "s7",
      "title": "Sai lầm thường gặp"
    },
    {
      "blocks": [
        {
          "columns": 3,
          "items": [
            {
              "text": "ROIC rất cao ở đỉnh giá dầu, rất thấp ở đáy.",
              "title": "Thượng nguồn và dịch vụ"
            },
            {
              "text": "ROIC ổn định hơn nhờ phí vận chuyển.",
              "title": "Trung nguồn"
            },
            {
              "text": "ROIC phụ thuộc biên lọc dầu và lãi lỗ tồn kho.",
              "title": "Hạ nguồn"
            }
          ],
