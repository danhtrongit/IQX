      "id": "s6",
      "title": "Ví dụ cụ thể"
    },
    {
      "blocks": [
        {
          "columns": 3,
          "items": [
            {
              "text": "Biên 21% là bình thường với chuỗi bán lẻ, thấp với nhà sản xuất hàng tiêu dùng.",
              "title": "So với nhà sản xuất"
            },
            {
              "text": "Thay đổi 0,5 điểm % đã có ý nghĩa lớn với lợi nhuận bán lẻ.",
              "title": "Bỏ qua thay đổi nhỏ"
            },
            {
              "text": "Khuyến mãi theo mùa làm biên quý dao động.",
              "title": "Đọc một quý"
            }
          ],
          "style": "tip",
          "type": "cards"
        }
      ],
      "id": "s7",
      "title": "Sai lầm thường gặp"
