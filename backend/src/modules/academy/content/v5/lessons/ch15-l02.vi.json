          "items": [
            {
              "text": "Biên gộp mỏng, phụ thuộc cơ cấu hàng và chiết khấu nhà cung cấp.",
              "title": "Chuỗi bán lẻ"
            },
            {
              "text": "Biên gộp cao, phụ thuộc giá nguyên liệu như sữa bột, đường, nhựa.",
              "title": "Sản xuất hàng tiêu dùng"
