      "title": "Ví dụ cụ thể"
    },
    {
      "blocks": [
        {
          "columns": 3,
          "items": [
            {
              "text": "Dùng bình quân đầu và cuối kỳ để tránh lệch do một ngày chốt sổ.",
              "title": "Dùng tồn kho cuối kỳ"
            },
            {
              "text": "Tồn kho ghi theo giá gốc, nên chia giá vốn.",
              "title": "Chia cho doanh thu"
            },
            {
              "text": "Dịch vụ, phân phối, lọc dầu có mức tồn kho khác nhau.",
              "title": "So mảng khác nhau"
            }
          ],
          "style": "tip",
          "type": "cards"
        }
      ],
      "id": "s7",
      "title": "Sai lầm thường gặp"
    },
    {
      "blocks": [
        {
          "columns": 3,
          "items": [
            {
              "text": "Tồn kho chủ yếu là vật tư, thiết bị. Ít chịu rủi ro giá dầu.",
              "title": "Thượng nguồn và dịch vụ"
            },
            {
              "text": "Tồn kho nhỏ, khí được vận chuyển liên tục.",
              "title": "Trung nguồn"
            },
            {
              "text": "Tồn kho dầu thô và xăng dầu lớn, rủi ro giá cao nhất.",
              "title": "Hạ nguồn"
            }
          ],
