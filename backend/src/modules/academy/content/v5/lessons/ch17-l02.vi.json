      "id": "s6",
      "title": "Ví dụ cụ thể"
    },
    {
      "blocks": [
        {
          "columns": 3,
          "items": [
            {
              "text": "Làm mờ các điểm đổi chiều.",
              "title": "Cộng 4 quý"
            },
            {
              "text": "Một quý biên cao có thể do lãi tồn kho.",
              "title": "Kết luận từ một quý"
            },
            {
              "text": "Thép, phân bón có mức nền khác nhau.",
              "title": "So khác mảng"
            }
          ],
          "style": "tip",
          "type": "cards"
        }
      ],
      "id": "s7",
      "title": "Sai lầm thường gặp"
    },
    {
      "blocks": [
        {
          "columns": 3,
          "items": [
            {
              "text": "Biên phụ thuộc giá thép so với quặng, than.",
              "title": "Thép"
            },
            {
              "text": "Biên phụ thuộc giá than, điện và giá bán xi măng.",
              "title": "Xi măng"
            },
            {
              "text": "Biên phụ thuộc giá khí đầu vào và giá phân bón thế giới.",
              "title": "Phân bón và hoá chất"
            }
          ],
          "style": "tip",
