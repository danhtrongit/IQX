      "id": "s6",
      "title": "Ví dụ cụ thể"
    },
    {
      "blocks": [
        {
          "columns": 3,
          "items": [
            {
              "text": "Cơ cấu chi phí khác hẳn.",
              "title": "So thủy điện với nhiệt điện"
            },
            {
              "text": "Mùa mưa làm biên quý dao động mạnh.",
              "title": "Đọc theo quý"
            },
            {
              "text": "Năm nhiều mưa làm biên cao bất thường.",
              "title": "Kết luận từ một năm thủy văn"
            }
          ],
          "style": "tip",
