            {
              "text": "Biên cao, đi theo lượng nước.",
              "title": "Thủy điện"
            },
            {
              "text": "Biên mỏng, đi theo giá than, khí.",
              "title": "Nhiệt điện"
            },
            {
              "text": "Gió, mặt trời có biên cao. Nước sạch biên ổn định.",
