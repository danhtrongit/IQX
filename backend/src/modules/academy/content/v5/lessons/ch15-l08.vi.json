        {
          "columns": 2,
          "items": [
            {
              "text": "CCC giảm dần hoặc âm. Mức tham khảo với chuỗi bán lẻ: dưới khoảng 30 ngày.",
              "title": "Chu kỳ ngắn",
              "tone": "pos"
            },
            {
              "text": "CCC tăng nhiều quý liền, thường do tồn kho tăng hoặc nhà cung cấp rút ngắn trả chậm.",
              "title": "Chu kỳ dài ra",
              "tone": "neg"
