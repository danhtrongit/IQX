            {
              "text": "Mức nền khác hẳn.",
              "title": "So ROA ngân hàng với sản xuất"
            },
            {
              "text": "Tài sản tăng nhanh làm ROA cuối kỳ thấp hơn thực tế. Dùng bình quân.",
              "title": "Dùng tổng tài sản cuối kỳ"
            },
            {
              "text": "ROA cao có thể do trích dự phòng ít.",
              "title": "Bỏ qua chi phí tín dụng"
            }
          ],
          "style": "tip",
