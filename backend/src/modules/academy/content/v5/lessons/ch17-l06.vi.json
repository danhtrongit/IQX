          "chart_id": "c17l6-g2",
          "type": "chart"
        },
        {
          "columns": 3,
          "items": [
            {
              "text": "Mỗi lô quặng, than được tài trợ bằng khoản vay ngắn hạn.",
              "title": "Vay để nhập nguyên liệu"
            },
            {
              "text": "Tồn kho mất giá trong khi khoản vay giữ nguyên.",
              "title": "Giá giảm là rủi ro kép"
            },
            {
              "text": "Tỷ lệ trên 1 có thể là dùng vay ngắn hạn xây nhà máy.",
              "title": "Vay ngắn hạn cho việc dài hạn"
            }
          ],
          "style": "tip",
          "type": "cards"
        }
      ],
      "id": "s2",
      "title": "Ở vật liệu cơ bản khác gì"
    },
