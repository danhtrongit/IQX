          "columns": 3,
          "items": [
            {
              "text": "Tăng khi xây, giảm khi vận hành.",
              "title": "Theo dõi chu kỳ dự án"
            },
            {
              "text": "Tính với EBITDA năm thủy văn kém.",
              "title": "Kiểm tra năm khô hạn"
            },
            {
              "text": "Khả năng trả lãi và trả gốc.",
