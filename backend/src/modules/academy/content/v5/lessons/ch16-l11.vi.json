    {
      "blocks": [
        {
          "columns": 2,
          "items": [
            {
              "text": "Dưới khoảng 3,5 lần với công ty điện. Mức tham khảo.",
              "title": "Khả năng trả nợ tốt",
              "tone": "pos"
            },
            {
              "text": "Trên khoảng 5 lần, hoặc tăng khi không có dự án mới. EBITDA khó đủ trả nợ đúng hạn.",
              "title": "Áp lực nợ",
              "tone": "neg"
            }
          ],
          "style": "card",
          "type": "cards"
        },
        {
          "text": "Với công ty đang xây nhà máy, chỉ tiêu tăng tạm thời là bình thường. Cần xem EBITDA có tăng khi nhà máy vận hành không.",
          "type": "paragraph"
        }
      ],
      "id": "s4",
      "title": "Đọc chỉ tiêu"
    },
    {
      "blocks": [
