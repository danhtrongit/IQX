              "title": "Đường phía trên"
            },
            {
              "text": "Nợ ròng và EBITDA 4 quý, đơn vị tỷ đồng.",
              "title": "Cột phía dưới"
            },
            {
              "text": "EBITDA tăng nhanh hơn nợ ròng làm đường đi xuống.",
              "title": "Đọc cùng nhau"
            }
          ],
          "style": "tip",
          "type": "cards"
        }
