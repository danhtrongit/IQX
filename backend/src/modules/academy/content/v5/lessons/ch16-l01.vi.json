      "id": "s6",
      "title": "Ví dụ cụ thể"
    },
    {
      "blocks": [
        {
          "columns": 3,
          "items": [
            {
              "text": "Mùa vụ làm quý 3 luôn cao hơn quý 4.",
              "title": "So quý liền kề"
            },
            {
              "text": "Thủy văn thay đổi theo năm.",
              "title": "Coi năm nhiều mưa là xu hướng"
            },
            {
              "text": "Nhà máy mới làm doanh thu tăng theo bậc, không phải tăng đều.",
              "title": "Bỏ qua công suất mới"
            }
          ],
          "style": "tip",
          "type": "cards"
        }
      ],
      "id": "s7",
      "title": "Sai lầm thường gặp"
    },
    {
      "blocks": [
        {
          "columns": 3,
          "items": [
            {
              "text": "Doanh thu đi theo lượng mưa, dao động mạnh giữa các năm.",
              "title": "Thủy điện"
            },
            {
              "text": "Doanh thu đi theo mức được huy động và giá nhiên liệu chuyển sang giá bán.",
              "title": "Nhiệt điện"
            },
            {
              "text": "Gió, mặt trời theo thời tiết. Nước sạch ổn định, tăng theo dân số và giá nước.",
              "title": "Tái tạo và nước"
            }
          ],
          "style": "tip",
          "type": "cards"
        }
      ],
      "id": "s8",
      "title": "Theo loại nguồn điện"
    }
