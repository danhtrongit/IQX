  "format": "iqx-academy-lesson-v3",
  "id": "ch12-l11",
  "intro_blocks": [],
  "kind": "lesson",
  "lead": "Tài sản công ty bảo hiểm chủ yếu là tiền gửi và trái phiếu, giá trị khá rõ ràng. Vì vậy P/B thường được dùng để định giá công ty bảo hiểm, nhất là phi nhân thọ.",
  "lesson_key": "fundamental:pb-bh",
  "order": 11,
  "sections": [
    {
      "blocks": [
        {
          "chart_id": "c12l11-g1",
          "type": "chart"
        },
        {
          "text": "P/B bằng <b>vốn hoá</b> chia <b>vốn chủ sở hữu</b> của quý gần nhất đã công bố. Cách tính giống bài P/B ở phần chỉ tiêu chung.",
          "type": "paragraph"
        }
      ],
      "id": "s1",
      "title": "Nhắc lại công thức"
    },
    {
      "blocks": [
        {
          "chart_id": "c12l11-g2",
          "type": "chart"
        },
        {
          "columns": 3,
          "items": [
            {
              "text": "Tiền gửi, trái phiếu ít bị định giá sai trên sổ sách.",
              "title": "Tài sản rõ ràng"
            },
            {
              "text": "Giá trị hợp đồng nhân thọ đang hiệu lực không có trên báo cáo tài chính, nên P/B nhân thọ ít phản ánh đủ giá trị.",
              "title": "Nhân thọ khó hơn"
            },
            {
              "text": "Công ty ROE cao bền vững đáng P/B cao hơn.",
              "title": "Đi cùng ROE"
            }
          ],
          "style": "tip",
          "type": "cards"
        }
      ],
      "id": "s2",
      "title": "Ở bảo hiểm khác gì"
    },
    {
      "blocks": [
        {
          "chart_id": "c12l11-rep",
          "title": "P/B",
          "type": "chart"
        },
        {
          "columns": 3,
          "items": [
            {
              "text": "P/B theo giá đóng cửa và vốn chủ quý đã công bố.",
              "title": "Đường theo ngày"
            },
            {
              "text": "Trung vị và dải cộng trừ một độ lệch chuẩn.",
              "title": "Đường nét đứt và dải"
            },
            {
              "text": "P/B dao động trong dải hẹp hơn công ty chứng khoán.",
              "title": "Đọc cùng nhau"
            }
          ],
          "style": "tip",
          "type": "cards"
        }
      ],
      "id": "s3",
      "title": "Biểu đồ đại diện"
    },
    {
      "blocks": [
        {
          "columns": 2,
          "items": [
            {
              "text": "P/B gần mức ROE chia khoảng 9% đến 10%. Ví dụ ROE 12% với P/B khoảng 1,3 lần. Đây là cách ước lượng thô để tham khảo.",
              "title": "Hợp lý",
              "tone": "pos"
            },
            {
              "text": "P/B cao trong khi combined ratio vượt 100% và ROE giảm.",
              "title": "Cần thận trọng",
              "tone": "neg"
            }
          ],
          "style": "card",
          "type": "cards"
        },
        {
          "text": "Với bảo hiểm nhân thọ, P/B chỉ là một góc nhìn. Phần giá trị hợp đồng đang hiệu lực nằm ngoài 3 báo cáo tài chính.",
          "type": "paragraph"
        }
      ],
      "id": "s4",
      "title": "Đọc chỉ tiêu"
    },
    {
      "blocks": [
        {
          "columns": 3,
          "items": [
            {
              "text": "Dùng dải trên Dashboard.",
              "title": "So với lịch sử"
            },
            {
              "text": "P/B thấp mà ROE ổn định là điểm đáng chú ý.",
              "title": "Đọc cùng ROE"
            },
            {
              "text": "Phi nhân thọ dùng P/B tốt hơn nhân thọ.",
              "title": "Phân biệt loại hình"
            }
          ],
          "style": "tip",
          "type": "cards"
        }
      ],
      "id": "s5",
      "title": "Cách sử dụng"
    },
    {
      "blocks": [
        {
          "text": "Công ty bảo hiểm mẫu, P/B 2 năm gần nhất.",
          "type": "paragraph"
        },
        {
          "items": [
            {
              "term": "P/B cuối Q2/26",
              "text": "1,34 lần."
            },
            {
              "term": "Trung vị 2 năm",
              "text": "1,46 lần."
            },
            {
              "term": "Thấp nhất và cao nhất",
              "text": "1,34 lần và 1,63 lần."
            },
            {
              "term": "So với ROE",
              "text": "ROE 4 quý 10,2%. P/B 1,34 lần gần mức ROE gợi ý theo cách ước lượng thô."
            }
          ],
          "type": "definitions"
        }
      ],
      "id": "s6",
      "title": "Ví dụ cụ thể"
    },
    {
      "blocks": [
        {
          "columns": 3,
          "items": [
            {
              "text": "Giá trị hợp đồng nhân thọ không có trên báo cáo.",
              "title": "Dùng P/B cho nhân thọ như phi nhân thọ"
            },
            {
              "text": "Nghiệp vụ lỗ kéo dài làm vốn chủ giảm.",
              "title": "Bỏ qua combined ratio"
            },
            {
              "text": "ROE và rủi ro khác nhau.",
              "title": "So với ngân hàng"
            }
          ],
          "style": "tip",
          "type": "cards"
        }
      ],
      "id": "s7",
      "title": "Sai lầm thường gặp"
    }
  ],
  "summary": [
    "<b>P/B</b> = vốn hoá ÷ vốn chủ sở hữu.",
    "Phù hợp nhất với <b>bảo hiểm phi nhân thọ</b>.",
    "P/B hợp lý <b>đi cùng ROE</b>.",
    "Giá trị hợp đồng nhân thọ <b>nằm ngoài 3 báo cáo</b>."
  ],
  "title": "P/B · ở công ty bảo hiểm"
}
