          "items": [
            {
              "text": "ROIC cao nhờ thuê mặt bằng và nhà cung cấp tài trợ hàng.",
              "title": "Chuỗi bán lẻ"
            },
            {
              "text": "ROIC phụ thuộc biên lợi nhuận và mức dùng nhà máy.",
