            {
              "text": "Nhà sản xuất cần nhà máy, ROIC thường thấp hơn.",
              "title": "So với nhà sản xuất"
            },
            {
              "text": "Có thể do nợ nhà cung cấp tăng tạm thời.",
              "title": "Coi ROIC cao luôn bền"
            },
            {
              "text": "Trừ tiền khỏi vốn đầu tư để đo đúng.",
              "title": "Quên tiền mặt"
            }
          ],
          "style": "tip",
