  "format": "iqx-academy-lesson-v3",
  "id": "ch15-l13",
  "intro_blocks": [],
  "kind": "lesson",
  "lead": "Bán lẻ và hàng tiêu dùng có lợi nhuận ổn định hơn nhiều ngành khác. Vì vậy P/E là thước đo định giá phù hợp nhất cho nhóm này. Bài này nói khi nào P/E cao là hợp lý.",
  "lesson_key": "fundamental:pe-bl",
  "order": 13,
  "sections": [
    {
      "blocks": [
        {
          "chart_id": "c15l13-g1",
          "type": "chart"
        },
        {
          "text": "P/E bằng <b>giá cổ phiếu</b> chia <b>EPS 4 quý</b>, theo ngày. Cách tính giống bài P/E ở phần chỉ tiêu chung.",
          "type": "paragraph"
        }
      ],
      "id": "s1",
      "title": "Nhắc lại công thức"
    },
    {
      "blocks": [
        {
          "chart_id": "c15l13-g2",
          "type": "chart"
        },
        {
          "columns": 3,
          "items": [
            {
              "text": "P/E ít bị nhiễu bởi chu kỳ như dầu khí hay bất động sản.",
              "title": "Lợi nhuận ổn định"
            },
            {
              "text": "Thị trường trả giá cao cho lợi nhuận đều và tăng trưởng.",
              "title": "Thường cao hơn thị trường"
            },
            {
              "text": "Chuỗi tăng trưởng nhanh có P/E cao hơn. Khi tăng trưởng chậm lại, P/E thường giảm.",
              "title": "Theo tăng trưởng"
            }
          ],
          "style": "tip",
          "type": "cards"
        }
      ],
      "id": "s2",
      "title": "Ở bán lẻ và tiêu dùng khác gì"
    },
    {
      "blocks": [
        {
          "chart_id": "c15l13-rep",
          "title": "P/E",
          "type": "chart"
        },
        {
          "columns": 3,
          "items": [
            {
              "text": "P/E theo giá đóng cửa và EPS 4 quý đã công bố.",
              "title": "Đường theo ngày"
            },
            {
              "text": "Trung vị và dải cộng trừ một độ lệch chuẩn.",
              "title": "Đường nét đứt và dải"
            },
            {
              "text": "P/E dao động trong dải hẹp hơn các ngành chu kỳ.",
              "title": "Đọc cùng nhau"
            }
          ],
          "style": "tip",
          "type": "cards"
        }
      ],
      "id": "s3",
      "title": "Biểu đồ đại diện"
    },
    {
      "blocks": [
        {
          "columns": 2,
          "items": [
            {
              "text": "P/E quanh trung vị lịch sử, tăng trưởng lợi nhuận ổn định.",
              "title": "Hợp lý",
              "tone": "pos"
            },
            {
              "text": "P/E trên dải lịch sử trong khi tăng trưởng doanh thu chậm lại.",
              "title": "Cần thận trọng",
              "tone": "neg"
            }
          ],
          "style": "card",
          "type": "cards"
        },
        {
          "text": "Đọc P/E <b>cùng tăng trưởng lợi nhuận</b>. P/E 20 lần với lợi nhuận tăng 20% mỗi năm khác hẳn P/E 20 lần với lợi nhuận đi ngang.",
          "type": "paragraph"
        }
      ],
      "id": "s4",
      "title": "Đọc chỉ tiêu"
    },
    {
      "blocks": [
        {
          "columns": 3,
          "items": [
            {
              "text": "Dùng dải trên Dashboard.",
              "title": "So với lịch sử"
            },
            {
              "text": "Xem bài PEG ở phần chỉ tiêu chung.",
              "title": "Đọc cùng tăng trưởng"
            },
            {
              "text": "Chuỗi bán lẻ so với chuỗi bán lẻ.",
              "title": "So cùng nhóm"
            }
          ],
          "style": "tip",
          "type": "cards"
        }
      ],
      "id": "s5",
      "title": "Cách sử dụng"
    },
    {
      "blocks": [
        {
          "text": "Công ty bán lẻ mẫu, P/E 2 năm gần nhất.",
          "type": "paragraph"
        },
        {
          "items": [
            {
              "term": "P/E cuối Q2/26",
              "text": "16,55 lần."
            },
            {
              "term": "Trung vị 2 năm",
              "text": "16,41 lần."
            },
            {
              "term": "Thấp nhất và cao nhất",
              "text": "13,78 lần và 22,22 lần."
            },
            {
              "term": "Nhận xét",
              "text": "P/E gần trung vị trong khi doanh thu vẫn tăng 9% và biên kinh doanh chính cải thiện."
            }
          ],
          "type": "definitions"
        }
      ],
      "id": "s6",
      "title": "Ví dụ cụ thể"
    },
    {
      "blocks": [
        {
          "columns": 3,
          "items": [
            {
              "text": "P/E bán lẻ thường cao hơn dầu khí, thép.",
              "title": "So với ngành chu kỳ"
            },
            {
              "text": "P/E cao chỉ hợp lý khi lợi nhuận tăng đều.",
              "title": "Bỏ qua tăng trưởng"
            },
            {
              "text": "Lãi bán tài sản làm P/E thấp giả.",
              "title": "Dùng EPS có lãi bất thường"
            }
          ],
          "style": "tip",
          "type": "cards"
        }
      ],
      "id": "s7",
      "title": "Sai lầm thường gặp"
    },
    {
      "blocks": [
        {
          "columns": 2,
          "items": [
            {
              "text": "P/E đi theo tốc độ mở rộng và tăng trưởng cửa hàng cũ.",
              "title": "Chuỗi bán lẻ"
            },
            {
              "text": "P/E cao, ổn định nhờ thương hiệu và nhu cầu thiết yếu.",
              "title": "Sản xuất hàng tiêu dùng"
            }
          ],
          "style": "tip",
          "type": "cards"
        }
      ],
      "id": "s8",
      "title": "Bán lẻ và hàng tiêu dùng"
    }
  ],
  "summary": [
    "<b>P/E</b> = giá ÷ EPS 4 quý.",
    "Lợi nhuận ổn định nên <b>P/E phù hợp</b> với nhóm này.",
    "P/E thường <b>cao hơn thị trường</b>.",
    "Đọc cùng <b>tăng trưởng lợi nhuận</b>."
  ],
  "title": "P/E · ở bán lẻ và tiêu dùng"
}
