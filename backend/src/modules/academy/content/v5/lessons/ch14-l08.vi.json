      "id": "s6",
      "title": "Ví dụ cụ thể"
    },
    {
      "blocks": [
        {
          "columns": 3,
          "items": [
            {
              "text": "FCF dao động theo giá dầu và lịch đầu tư.",
              "title": "Kết luận từ một năm"
            },
            {
              "text": "Lợi nhuận tăng nhưng FCF giảm là chuyện thường khi giá dầu tăng.",
              "title": "Chỉ nhìn LNST"
            },
            {
              "text": "Dự án lớn đã công bố sẽ làm FCF thấp vài năm.",
              "title": "Quên capex lớn sắp tới"
            }
          ],
          "style": "tip",
          "type": "cards"
        }
      ],
      "id": "s7",
      "title": "Sai lầm thường gặp"
    },
    {
      "blocks": [
        {
          "columns": 3,
          "items": [
            {
              "text": "FCF dao động mạnh theo giá dầu và đầu tư giàn khoan, tàu.",
              "title": "Thượng nguồn và dịch vụ"
            },
            {
              "text": "FCF ổn định hơn, nhưng giảm mạnh khi xây đường ống mới.",
              "title": "Trung nguồn"
            },
            {
              "text": "Vốn lưu động lớn nên FCF nhạy với giá dầu nhất.",
              "title": "Hạ nguồn"
            }
          ],
          "style": "tip",
          "type": "cards"
        }
      ],
      "id": "s8",
      "title": "Theo từng mảng"
    }
