      ],
      "id": "s6",
      "title": "Ví dụ cụ thể"
    },
    {
      "blocks": [
        {
          "columns": 3,
          "items": [
            {
              "text": "Ở chỉ tiêu này EBITDA chỉ tính phần vận hành.",
              "title": "Cộng doanh thu tài chính"
            },
            {
              "text": "Kỳ không có dòng khấu hao thì để trống.",
              "title": "Lấy khấu hao từ thuyết minh"
            },
            {
              "text": "Còn phải trừ khấu hao, lãi vay và thuế.",
              "title": "Coi EBITDA là lợi nhuận"
            }
          ],
          "style": "tip",
          "type": "cards"
        }
      ],
      "id": "s7",
      "title": "Sai lầm thường gặp"
    },
    {
      "blocks": [
        {
          "columns": 3,
          "items": [
            {
              "text": "Biên EBITDA rất cao vì gần như không tốn nhiên liệu.",
              "title": "Thủy điện"
            },
            {
              "text": "Biên mỏng hơn vì chi phí nhiên liệu là tiền mặt.",
              "title": "Nhiệt điện"
            },
            {
              "text": "Gió, mặt trời biên EBITDA cao. Nước sạch biên ổn định.",
              "title": "Tái tạo và nước"
            }
          ],
          "style": "tip",
          "type": "cards"
        }
      ],
      "id": "s8",
      "title": "Theo loại nguồn điện"
    }
