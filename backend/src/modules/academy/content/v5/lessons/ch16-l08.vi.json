        {
          "columns": 3,
          "items": [
            {
              "text": "Đập và hồ chứa cần vốn rất lớn, xây lâu.",
              "title": "Thủy điện"
            },
            {
              "text": "Nhà máy lớn, capex tập trung vài năm.",
              "title": "Nhiệt điện"
            },
            {
              "text": "Gió, mặt trời capex lớn nhưng xây nhanh.",
              "title": "Tái tạo và nước"
