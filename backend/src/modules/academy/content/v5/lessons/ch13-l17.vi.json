      "id": "s6",
      "title": "Ví dụ cụ thể"
    },
    {
      "blocks": [
        {
          "columns": 3,
          "items": [
            {
              "text": "CFO âm ở công ty đang xây dự án không có nghĩa là lợi nhuận ảo.",
              "title": "Kết luận lợi nhuận kém chất lượng"
            },
            {
              "text": "Cần nhìn cả chu kỳ dự án.",
              "title": "Đọc một năm"
            },
            {
              "text": "CFO âm kéo dài thì phải có nguồn bù, thường là nợ vay.",
              "title": "Bỏ qua nợ vay"
            }
          ],
          "style": "tip",
