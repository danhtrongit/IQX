      "id": "s6",
      "title": "Ví dụ cụ thể"
    },
    {
      "blocks": [
        {
          "columns": 3,
          "items": [
            {
              "text": "Capex lấy từ lưu chuyển tiền tệ, mã 21.",
              "title": "Dùng capex trên bảng cân đối"
            },
            {
              "text": "Đầu tư sai thời điểm chu kỳ có thể làm giảm hiệu quả vốn.",
              "title": "Coi capex cao luôn là tốt"
            },
            {
              "text": "Dự án dầu khí kéo dài nhiều năm. Xem xu hướng.",
              "title": "Đọc một năm"
            }
          ],
          "style": "tip",
          "type": "cards"
        }
      ],
      "id": "s7",
      "title": "Sai lầm thường gặp"
    },
    {
      "blocks": [
        {
          "columns": 3,
          "items": [
            {
              "text": "Đầu tư giàn khoan, tàu theo chu kỳ giá dầu. Tỷ lệ dao động mạnh.",
              "title": "Thượng nguồn và dịch vụ"
            },
            {
              "text": "Đầu tư đường ống, kho cảng theo dự án lớn, kéo dài nhiều năm.",
              "title": "Trung nguồn"
            },
            {
              "text": "Nhà máy lọc dầu đầu tư lớn một lần, sau đó tỷ lệ thấp.",
              "title": "Hạ nguồn"
            }
          ],
