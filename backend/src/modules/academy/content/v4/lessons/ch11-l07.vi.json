      "id": "s6",
      "title": "Ví dụ cụ thể"
    },
    {
      "blocks": [
        {
          "columns": 3,
          "items": [
            {
              "text": "FVTPL và HTM có rủi ro rất khác nhau dù cùng là tài sản tự doanh.",
              "title": "Gộp chung ba loại"
            },
            {
              "text": "Tỷ trọng cao nhưng chủ yếu là tiền gửi thì rủi ro không lớn.",
              "title": "Coi tỷ trọng cao là xấu"
            },
            {
              "text": "Tỷ trọng thay đổi theo giá thị trường và theo quy mô tổng tài sản.",
              "title": "Nhìn một quý"
            }
