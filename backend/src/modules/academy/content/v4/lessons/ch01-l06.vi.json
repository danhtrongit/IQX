                "Trên sàn"
              ]
            },
            {
              "cells": [
                "Giá giao dịch",
                "Giá khớp lệnh",
                "Giá NAV",
                "Giá khớp lệnh"
              ]
            },
            {
              "cells": [
                "Chi phí thêm",
                "Không",
                "Phí quản lý quỹ",
