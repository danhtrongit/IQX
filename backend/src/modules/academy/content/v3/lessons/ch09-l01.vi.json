    },
    {
      "blocks": [
        {
          "columns": 3,
          "items": [
            {
              "text": "Lãi 5 tỷ đồng mỗi năm vẫn tạo chuỗi dài, nhưng không đủ hấp dẫn.",
              "title": "Chỉ nhìn chuỗi, bỏ qua mức lãi"
            },
            {
              "text": "Một năm có lãi nhờ bán tài sản vẫn được tính vào chuỗi, dù kinh doanh chính đang lỗ.",
              "title": "Bỏ qua lãi bất thường"
            },
            {
              "text": "Một năm lỗ do khủng hoảng chung của ngành có thể không phản ánh sức khỏe lâu dài.",
              "title": "Loại ngay vì một năm lỗ"
