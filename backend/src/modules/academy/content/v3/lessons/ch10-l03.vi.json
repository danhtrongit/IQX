  "summary": [
    "<b>ROIC</b> = NOPAT 4 quý ÷ <b>vốn đầu tư bình quân</b>.",
    "<b>NOPAT</b> = EBIT × (1 − thuế suất). <b>Vốn đầu tư</b> = vốn chủ + nợ vay − tiền.",
    "ROIC <b>cao hơn chi phí vốn</b> là tạo ra giá trị, thấp hơn là phá hủy giá trị.",
    "ROIC <b>cao và ổn định</b> nhiều năm là dấu hiệu của lợi thế cạnh tranh."
  ],
  "title": "ROIC · tỷ suất lợi nhuận trên vốn đầu tư"
}
