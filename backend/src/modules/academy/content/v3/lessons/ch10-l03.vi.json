      "id": "s6",
      "title": "Ví dụ cụ thể"
    },
    {
      "blocks": [
        {
          "columns": 3,
          "items": [
            {
              "text": "LNST đã trừ lãi vay. ROIC cần lợi nhuận trước lãi vay, sau thuế.",
              "title": "Dùng lợi nhuận sau thuế"
            },
            {
              "text": "Doanh nghiệp giữ nhiều tiền sẽ có ROIC thấp hơn thực tế.",
              "title": "Quên trừ tiền mặt"
            },
            {
              "text": "ROIC có thể giảm tạm thời khi vừa đầu tư dự án lớn chưa tạo doanh thu.",
              "title": "Chỉ nhìn một năm"
            }
          ],
          "style": "tip",
