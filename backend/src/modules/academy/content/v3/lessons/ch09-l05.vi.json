      "id": "s6",
      "title": "Ví dụ cụ thể"
    },
    {
      "blocks": [
        {
          "columns": 3,
          "items": [
            {
              "text": "ROIC 3% đều đặn nghĩa là vốn sinh lời kém, có khi thấp hơn lãi tiền gửi.",
              "title": "Ổn định ở mức thấp"
            },
            {
              "text": "Vốn tăng mạnh khi xây nhà máy làm ROIC giảm tạm thời, không hẳn là hiệu quả kém đi.",
              "title": "Bỏ qua năm đầu tư lớn"
            },
            {
              "text": "Ngân hàng dùng nợ làm nguyên liệu kinh doanh, ROIC không phù hợp để đánh giá.",
              "title": "Áp dụng cho ngân hàng"
            }
          ],
          "style": "tip",
