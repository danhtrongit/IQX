    {
      "blocks": [
        {
          "columns": 2,
          "items": [
            {
              "chart_id": "c1l1-a1",
              "text": "Đầu tư bất động sản cần nguồn vốn hàng tỷ đồng, trong khi với chứng khoán, nhà đầu tư có thể bắt đầu <b>chỉ từ vài triệu đồng</b>.",
              "title": "Vốn đầu tư linh hoạt"
            },
            {
              "chart_id": "c1l1-a2",
              "text": "Lệnh bán có thể khớp ngay trong phiên và <b>tiền về tài khoản sau 2 ngày làm việc</b>. Trong khi đó, một giao dịch bất động sản thường kéo dài nhiều tuần, thậm chí nhiều tháng.",
              "title": "Thanh khoản cao"
            },
            {
              "chart_id": "c1l1-a3",
              "text": "Khi doanh nghiệp kinh doanh tốt, cổ đông được hưởng thành quả thông qua <b>giá cổ phiếu tăng và cổ tức</b>.",
              "title": "Đồng sở hữu doanh nghiệp"
            },
            {
              "chart_id": "c1l1-a4",
              "text": "Giá giao dịch được công khai theo thời gian thực. Doanh nghiệp niêm yết có nghĩa vụ <b>công bố báo cáo tài chính hằng quý</b>, giúp nhà đầu tư theo dõi tình hình kinh doanh.",
              "title": "Minh bạch thông tin"
            },
            {
              "chart_id": "c1l1-a5",
              "text": "Phí giao dịch chứng khoán thấp, <b>thuế khi bán chỉ 0,1%</b> giá trị giao dịch. Ngược lại, mua bán bất động sản phát sinh thuế, phí công chứng và sang tên, còn vàng chịu chênh lệch giữa giá mua và giá bán.",
              "title": "Chi phí giao dịch thấp"
            }
          ],
          "layout": "rows",
          "type": "chart_grid"
        }
      ],
      "id": "s3",
      "title": "Năm lợi thế của đầu tư chứng khoán"
