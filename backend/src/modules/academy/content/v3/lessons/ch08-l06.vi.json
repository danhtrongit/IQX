      "title": "Ví dụ cụ thể"
    },
    {
      "blocks": [
        {
          "columns": 3,
          "items": [
            {
              "text": "Lợi nhuận tăng không có nghĩa phần của mỗi cổ phiếu tăng tương ứng.",
              "title": "Chỉ xem LNST CAGR"
            },
            {
              "text": "Năm gốc lỗ thì EPS CAGR không có ý nghĩa.",
              "title": "Tính khi EPS năm đầu âm"
            },
            {
              "text": "EPS 2023 giảm gần 30%. CAGR 8,1% không cho thấy điều này.",
              "title": "Bỏ qua năm giảm ở giữa"
            }
          ],
