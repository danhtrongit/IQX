# Core runtime
APP_ENV=development
HOST=0.0.0.0
TRUST_PROXY_CIDRS=
PORT=3000
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000

# PostgreSQL v2 (database name must match iqx_v2_* for guarded migrations)
DATABASE_URL=
DB_POOL_MAX=5
DB_CONNECT_TIMEOUT_MS=2000
DB_STATEMENT_TIMEOUT_MS=3000
DB_READ_ONLY=false

# Redis, queue, throttling, and process ownership
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:16379/15
REDIS_CONNECT_TIMEOUT_MS=2000
QUEUE_ENABLED=false
MARKET_INGEST_ENABLED=false
RATE_LIMIT_MAX=60
RATE_LIMIT_TTL_MS=60000

# HTTP and API contracts
CORS_ORIGINS=http://localhost:5173
API_DOCS_ENABLED=true
COMPATIBILITY_V1_ENABLED=true
APP_PUBLIC_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3000

# Authentication (production requires both values, each at least 32 chars)
JWT_SECRET_KEY=
JWT_REFRESH_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email provider
EMAIL_ENABLED=false
EMAIL_PROVIDER_URL=
EMAIL_API_KEY=
# EMAIL_SENDER=

# SePay billing
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
SEPAY_CHECKOUT_URL=https://pay-sandbox.sepay.vn/v1/checkout/init

# AI provider (OpenAI-compatible)
AI_PROXY_BASE_URL=
AI_PROXY_API_KEY=
AI_PROXY_MODEL=deepseek-flash
# DeepSeek-V4.1-Flash API ID: https://api-docs.deepseek.com/quick_start/pricing
# Omit for providers that do not support DeepSeek's thinking parameter.
AI_PROXY_THINKING=disabled
AI_PROXY_TIMEOUT_MS=120000
AI_PROXY_RETRIES=2

# Journey and alert jobs
CAP_MAX_ENABLED=6
JOURNEY_QA_GRANTS_ENABLED=false
ALERT_COOLDOWN_SECONDS=900
ALERT_SCAN_ENABLED=false

# Google Sheets market inputs
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_API_KEY=

# Realtime gateway and DNSE market ingest
REALTIME_ENABLED=false
DNSE_TRANSPORT=auto
DNSE_OPENAPI_WS_URL=
DNSE_API_KEY=
DNSE_API_SECRET=
DNSE_MQTT_URL=
DNSE_MQTT_HOST=
DNSE_MQTT_PORT=
DNSE_MQTT_WS_PATH=/mqtt
DNSE_AUTH_URL=
DNSE_ME_URL=
DNSE_USERNAME=
DNSE_PASSWORD=
# Backward-compatible realtime DNSE aliases
REALTIME_DNSE_MQTT_URL=
REALTIME_DNSE_USERNAME=
REALTIME_DNSE_PASSWORD=
REALTIME_MAX_SYMBOLS=90
REALTIME_LEASE_TTL_SECONDS=30
REALTIME_LEASE_RENEW_SECONDS=10

# Telegram integration
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_LINK_TTL_SECONDS=600

# Private media storage (MEDIA_ROOT must be an absolute path). In Docker, mount
# persistent storage at /app/media and set MEDIA_ROOT=/app/media; the example's
# empty value overrides the image default when passed with --env-file.
MEDIA_ROOT=
MEDIA_SIGNING_SECRET=
MEDIA_URL_TTL_SECONDS=300
MEDIA_MAX_THUMBNAIL_MB=5
MEDIA_MAX_PDF_MB=100
MEDIA_MAX_VIDEO_MB=500
