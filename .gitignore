# Ignore everything at the repository root by default.
/*

# Keep the root gitignore itself.
!/.gitignore

# Repository agent instructions.
!/AGENTS.md

# Only track the application directories.
!/frontend/
!/frontend/**
!/backend/
!/backend/**

# IQX backend v2 (NestJS rewrite).
!/backend-v2/
!/backend-v2/**
# Integrated v2 frontend, published alongside the v2 API.
!/frontend-v2/
!/frontend-v2/**
/frontend-v2/.git
!/dashboard/
!/dashboard/**
!/admin/
!/admin/**

# IQX v2 Node backend (frontend intentionally untracked for now).
!/iqx-v2/
/iqx-v2/*
!/iqx-v2/backend/
!/iqx-v2/backend/**

# CI workflows.
!/.github/
!/.github/**

# Safety guard if the frontend was previously a standalone repo.
/frontend/.git

# OS noise.
.DS_Store
