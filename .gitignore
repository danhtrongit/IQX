# Ignore everything at the repository root by default.
/*

# Keep the root gitignore itself.
!/.gitignore

# Repository agent instructions.
!/AGENTS.md
!/CLAUDE.md

# Application directories: NestJS API, web frontend, mobile, Rust desktop.
!/backend/
!/backend/**
!/frontend/
!/frontend/**
!/mobile/
!/mobile/**
!/desktop/
!/desktop/**
# Safety guard: frontend was previously a standalone repo.
/frontend/.git

# CI workflows.
!/.github/
!/.github/**

# OS noise.
.DS_Store
