# Ignore everything at the repository root by default.
/*

# Keep the root gitignore itself.
!/.gitignore

# Repository agent instructions.
!/AGENTS.md

# Application directories: NestJS API and integrated web frontend.
!/backend/
!/backend/**
!/frontend/
!/frontend/**
# Safety guard: frontend was previously a standalone repo.
/frontend/.git

# Expo mobile workspace.
!/apps/
!/apps/**
!/packages/
!/packages/**
!/package.json
!/pnpm-workspace.yaml
!/pnpm-lock.yaml
/apps/**/node_modules/
/packages/**/node_modules/
/apps/**/.env
/apps/**/.env.*
!/apps/**/.env.example
/apps/**/.expo/

# CI workflows.
!/.github/
!/.github/**

# OS noise.
.DS_Store
