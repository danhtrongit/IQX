{
  "name": "@iqx/backend-v2",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "IQX modular NestJS API with an independent PostgreSQL v2 schema",
  "engines": {
    "node": "^24.15.0 || >=26.0.0",
    "npm": ">=11"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node dist/scripts/copy-assets.js",
    "dev": "tsc -p tsconfig.build.json --watch",
    "start:api": "node dist/src/bootstrap/api.js",
    "start:worker": "node dist/src/bootstrap/worker.js",
    "start:market-ingest": "node dist/src/bootstrap/market-ingest.js",
    "lint": "eslint src test scripts --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:system": "vitest run --config vitest.system.config.ts",
    "test:frontend": "vitest run --config vitest.browser.config.ts",
    "db:migrate": "node dist/scripts/migrate.js",
    "api:coverage": "node dist/scripts/api-coverage.js",
    "api:coverage:check": "node dist/scripts/api-coverage.js --check",
    "contracts:legacy": "python3 scripts/generate-legacy-contract.py",
    "contracts:generate": "npm run build && node dist/scripts/export-openapi.js && node dist/scripts/generate-client.js",
    "contracts:check": "python3 scripts/generate-legacy-contract.py --check && npm run build && node dist/scripts/export-openapi.js --check && node dist/scripts/generate-client.js --check",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run contracts:check"
  },
  "dependencies": {
    "@fastify/helmet": "13.1.1",
    "@fastify/multipart": "10.1.2",
    "@fastify/static": "10.1.2",
    "@nestjs/common": "12.0.4",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.0.4",
    "@nestjs/platform-fastify": "12.0.4",
    "@nestjs/platform-ws": "12.0.4",
    "@nestjs/swagger": "12.0.1",
    "@nestjs/throttler": "6.7.0",
    "@nestjs/websockets": "12.0.4",
    "bcrypt": "6.0.0",
    "bullmq": "6.3.8",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "file-type": "21.3.4",
    "ioredis": "5.11.1",
    "jose": "6.2.12",
    "mqtt": "5.16.0",
    "nestjs-pino": "5.2.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ws": "8.21.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bcrypt": "6.0.0",
    "@types/ws": "8.18.1",
    "@eslint/js": "10.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@nestjs/testing": "12.0.4",
    "@swc/core": "1.16.2",
    "@testcontainers/postgresql": "12.1.0",
    "@testcontainers/redis": "12.1.0",
    "@types/node": "24.12.0",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.11.0",
    "prettier": "3.9.8",
    "testcontainers": "12.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.1"
  },
  "overrides": {
    "@hey-api/json-schema-ref-parser": {
      "js-yaml": "4.3.2"
    }
  }
}
